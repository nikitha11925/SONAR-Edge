# ==========================================
# Datasets & Large Archives (Prevent GitHub 100MB limit errors)
# ==========================================
dataset/*.zip
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Raw dataset files
dataset/cwru/*.mat
*.mat

# ==========================================
# Compiled Executables & Libraries
# ==========================================
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.lib
*.a

# ==========================================
# Python Bytecode & Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# Sensitive Files & Local Configs
# ==========================================
.env
.env.*
secrets.json
*.pem
*.key

# ==========================================
# IDE & System Files
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.metadata/

# ==========================================
# Presentations, proposals, papers (kept locally, not in git)
# ==========================================
ppts/
*.ppt
*.pptx
*.doc
*.docx
*.pdf
~$*

# ==========================================
# ESP-IDF / firmware build output (rebuilt by "idf.py build")
# ==========================================
build/
managed_components/
sdkconfig.old
eim_config.toml

# ==========================================
# Recordings and generated outputs
# ==========================================
own_data/
*.wav
*.mp3
*.m4a
acoustic/demo_output/
*.log
